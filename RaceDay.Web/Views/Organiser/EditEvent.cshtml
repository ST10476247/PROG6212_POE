@model EditEventViewModel
@{
    ViewData["Title"] = "Edit Event: " + Model.Title;
}

<div class="bg-dark text-white py-4 border-bottom border-secondary mb-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <span class="role-badge-organiser mb-2 d-inline-block">Event Editor</span>
                <h1 class="h3 fw-bold mb-1">Edit Event: @Model.Title</h1>
                <p class="text-white-50 small mb-0">Modify details, update course landmarks, or upload a new Azure Blob Storage banner</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Categories" asp-route-eventId="@Model.EventId" class="btn btn-outline-warning text-dark btn-sm">
                    <i class="bi bi-tags me-1"></i> Categories
                </a>
                <a asp-action="Events" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Events
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0 rounded-4 p-4 p-md-5 bg-white">
                <form asp-action="EditEvent" method="post" enctype="multipart/form-data" novalidate>
                    <input type="hidden" asp-for="EventId" />
                    <input type="hidden" asp-for="ExistingBannerUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-4"></div>

                    <!-- Section 1: Core Details -->
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-flag-fill text-primary me-2"></i>1. Core Event Information
                    </h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label small fw-bold text-muted text-uppercase">Event Name / Title *</label>
                            <input asp-for="Title" class="form-control" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EventType" class="form-label small fw-bold text-muted text-uppercase">Event Type *</label>
                            <select asp-for="EventType" class="form-select" required>
                                <option value="Running">Running</option>
                                <option value="Cycling">Cycling</option>
                                <option value="Walking">Walking</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label small fw-bold text-muted text-uppercase">Event Description *</label>
                            <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Section 2: Dates & Location -->
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-geo-alt-fill text-danger me-2"></i>2. Date & Location
                    </h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label small fw-bold text-muted text-uppercase">Race Date *</label>
                            <input asp-for="StartDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label small fw-bold text-muted text-uppercase">End Date</label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="City" class="form-label small fw-bold text-muted text-uppercase">Host City *</label>
                            <input asp-for="City" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Province" class="form-label small fw-bold text-muted text-uppercase">Province *</label>
                            <select asp-for="Province" class="form-select" required>
                                <option value="Gauteng">Gauteng</option>
                                <option value="Western Cape">Western Cape</option>
                                <option value="KwaZulu-Natal">KwaZulu-Natal</option>
                                <option value="Eastern Cape">Eastern Cape</option>
                                <option value="Free State">Free State</option>
                                <option value="Mpumalanga">Mpumalanga</option>
                                <option value="Limpopo">Limpopo</option>
                                <option value="North West">North West</option>
                                <option value="Northern Cape">Northern Cape</option>
                            </select>
                        </div>
                    </div>

                    <!-- Section 3: Entries, Fees & Elevation -->
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-speedometer2 text-success me-2"></i>3. Entrant Field & Specs
                    </h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="EntryFeeZar" class="form-label small fw-bold text-muted text-uppercase">Base Entry Fee (ZAR)</label>
                            <div class="input-group">
                                <span class="input-group-text">R</span>
                                <input asp-for="EntryFeeZar" type="number" step="10" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="MaxEntries" class="form-label small fw-bold text-muted text-uppercase">Max Field Size</label>
                            <input asp-for="MaxEntries" type="number" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label small fw-bold text-muted text-uppercase">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Open">Open</option>
                                <option value="Draft">Draft</option>
                                <option value="Closed">Closed</option>
                                <option value="Completed">Completed</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ElevationGainMeters" class="form-label small fw-bold text-muted text-uppercase">Elevation Gain (Meters)</label>
                            <input asp-for="ElevationGainMeters" type="number" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="TerrainType" class="form-label small fw-bold text-muted text-uppercase">Terrain</label>
                            <input asp-for="TerrainType" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="RouteUrl" class="form-label small fw-bold text-muted text-uppercase">Route URL</label>
                            <input asp-for="RouteUrl" type="url" class="form-control" />
                        </div>

                        <div class="col-12">
                            <label asp-for="KeyLandmarks" class="form-label small fw-bold text-muted text-uppercase">Key Course Landmarks</label>
                            <input asp-for="KeyLandmarks" class="form-control" />
                        </div>
                    </div>

                    <!-- Section 4: Banner Image Upload (Azure Blob Storage) -->
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-cloud-arrow-up-fill text-info me-2"></i>4. Banner Image (Azure Blob Storage)
                    </h5>

                    <div class="p-3 bg-light rounded-4 border mb-4">
                        @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
                        {
                            <div class="mb-3">
                                <small class="text-muted fw-bold d-block mb-1">Current Active Banner:</small>
                                <img src="@Model.ExistingBannerUrl" alt="@Model.Title" class="img-fluid rounded-3 shadow-sm" style="max-height: 180px; object-fit: cover;" />
                            </div>
                        }

                        <label asp-for="BannerImageFile" class="form-label small fw-bold text-uppercase text-muted">Upload New Banner Image</label>
                        <input asp-for="BannerImageFile" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="BannerImageFile" class="text-danger small"></span>
                        <small class="text-muted d-block mt-1">Uploading a new image will stream it to the Part 2 API and store it in Azure Blob Storage container <code>raceday-banners</code>.</small>
                    </div>

                    <div class="d-flex justify-content-end gap-3 pt-3 border-top">
                        <a asp-action="Events" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-raceday-primary px-5 py-2 fs-6">
                            <i class="bi bi-save me-1"></i> Update Event Details
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

