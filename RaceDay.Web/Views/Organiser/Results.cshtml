@model EventResultsEntryViewModel
@{
    ViewData["Title"] = "Results Entry: " + Model.EventTitle;
}

<div class="bg-dark text-white py-4 border-bottom border-secondary mb-4">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <span class="role-badge-organiser mb-2 d-inline-block">Race Timing Operations</span>
                <h1 class="h3 fw-bold mb-1"><i class="bi bi-stopwatch text-warning me-2"></i>Results Entry: @Model.EventTitle</h1>
                <p class="text-white-50 small mb-0">Capture gun finish times and assign official finishing positions for enrolled participants</p>
            </div>
            <div class="mt-3 mt-md-0 d-flex gap-2">
                <a asp-action="Enrolments" asp-route-eventId="@Model.EventId" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-people-fill me-1"></i> Enrolments
                </a>
                <a asp-action="Events" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Events List
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    <!-- Action Banner & Auto-Rank Utility -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h5 class="fw-bold text-dark mb-1">Official Finish Line Timing Mat</h5>
                <p class="text-muted small mb-0">
                    Enter the finish time (<code>HH:mm:ss</code>) for each participant. You can use <strong>Auto-Rank by Time</strong> to automatically order runners and assign positions from fastest to slowest.
                </p>
            </div>
            <div class="d-flex gap-2">
                <button type="button" id="btnAutoRank" class="btn btn-outline-warning text-dark btn-sm rounded-pill px-3 shadow-sm">
                    <i class="bi bi-sort-numeric-down me-1"></i> Auto-Rank by Time
                </button>
            </div>
        </div>
    </div>

    @if (!Model.Entrants.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4 bg-white">
            <div class="mb-3 text-muted"><i class="bi bi-people fs-1"></i></div>
            <h4>No Athletes to Score</h4>
            <p class="text-muted">No participants have enrolled for this event yet. Timing results can be recorded after athletes register.</p>
            <div class="mt-2">
                <a asp-action="Events" class="btn btn-outline-primary rounded-pill px-4">Back to Events</a>
            </div>
        </div>
    }
    else
    {
        <form asp-action="BatchCaptureResults" asp-route-eventId="@Model.EventId" method="post">
            <div class="table-card mb-4">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-bold text-dark">Timing Roster</span>
                        <small class="text-muted ms-2">(@Model.RecordedResultsCount / @Model.TotalEntrants Results Published)</small>
                    </div>
                    <button type="submit" class="btn btn-raceday-accent btn-sm rounded-pill px-4">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Save & Publish All Results
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-raceday mb-0 align-middle">
                        <thead>
                            <tr>
                                <th style="width: 100px;">Bib #</th>
                                <th>Participant Name</th>
                                <th>Category</th>
                                <th style="width: 180px;">Finish Time (HH:mm:ss)</th>
                                <th style="width: 140px;">Position</th>
                                <th style="width: 130px;">Status</th>
                                <th class="text-center" style="width: 120px;">Published?</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Entrants.Count; i++)
                            {
                                var entrant = Model.Entrants[i];
                                <tr class="results-entry-row @(entrant.IsPublished ? "table-light" : "")">
                                    <td>
                                        <input type="hidden" name="entrants[@i].EnrolmentId" value="@entrant.EnrolmentId" />
                                        <input type="hidden" name="entrants[@i].BibNumber" value="@entrant.BibNumber" />
                                        <input type="hidden" name="entrants[@i].ParticipantName" value="@entrant.ParticipantName" />
                                        <div class="race-bib py-1 px-2" style="border-width: 2px;">
                                            <div class="race-bib-header" style="font-size: 0.5rem;">BIB</div>
                                            <div class="race-bib-number" style="font-size: 1.1rem;">#@entrant.BibNumber</div>
                                        </div>
                                    </td>
                                    <td>
                                        <strong class="text-dark">@entrant.ParticipantName</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">@entrant.CategoryName</span>
                                        <small class="text-muted d-block">@entrant.DistanceKm km</small>
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text"><i class="bi bi-stopwatch"></i></span>
                                            <input type="text" name="entrants[@i].FinishTimeString" value="@entrant.FinishTimeString"
                                                   class="form-control form-control-sm time-input font-monospace" placeholder="03:45:22" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">#</span>
                                            <input type="number" name="entrants[@i].Position" value="@entrant.Position"
                                                   class="form-control form-control-sm pos-input fw-bold" placeholder="Pos" />
                                        </div>
                                    </td>
                                    <td>
                                        <select name="entrants[@i].Status" class="form-select form-select-sm">
                                            <option value="Finished" selected="@(entrant.Status == "Finished")">Finished</option>
                                            <option value="DNF" selected="@(entrant.Status == "DNF")">DNF (Did Not Finish)</option>
                                            <option value="DNS" selected="@(entrant.Status == "DNS")">DNS (Did Not Start)</option>
                                            <option value="DQ" selected="@(entrant.Status == "DQ")">Disqualified</option>
                                        </select>
                                    </td>
                                    <td class="text-center">
                                        @if (entrant.IsPublished)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Published</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-dash"></i> Uncaptured</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="p-3 border-top d-flex justify-content-between align-items-center bg-light">
                    <span class="text-muted small">
                        <i class="bi bi-shield-check text-success me-1"></i> Changes will immediately update athlete finish certificates and leaderboards.
                    </span>
                    <button type="submit" class="btn btn-raceday-accent px-4">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Save & Publish All Results
                    </button>
                </div>
            </div>
        </form>
    }
</div>

