@model List<OrganiserEventSummaryViewModel>
@{
    ViewData["Title"] = "Events Management";
}

<div class="bg-dark text-white py-4 border-bottom border-secondary mb-4">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <span class="role-badge-organiser mb-2 d-inline-block">Organiser Management</span>
                <h1 class="h3 fw-bold mb-1">My Road Events</h1>
                <p class="text-white-50 small mb-0">Create, edit, delete events, configure categories, and view participants</p>
            </div>
            <div class="mt-3 mt-md-0">
                <a asp-action="CreateEvent" class="btn btn-raceday-accent">
                    <i class="bi bi-plus-circle-fill me-1"></i> Create New Event
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4 bg-white">
            <div class="mb-3 text-muted"><i class="bi bi-calendar-x fs-1"></i></div>
            <h4>No Events Created Yet</h4>
            <p class="text-muted">Start by creating your first road event, marathon, cycle tour, or walking race.</p>
            <div class="mt-2">
                <a asp-action="CreateEvent" class="btn btn-raceday-primary rounded-pill px-4">
                    <i class="bi bi-plus-circle me-1"></i> Host Your First Event
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-responsive">
                <table class="table table-raceday mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Banner & Title</th>
                            <th>Sport & Dates</th>
                            <th>Location</th>
                            <th>Fee & Entries</th>
                            <th>Status</th>
                            <th class="text-end">Manage Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(ev.BannerUrl))
                                        {
                                            <img src="@ev.BannerUrl" alt="@ev.Title" class="rounded-3 shadow-sm" style="width: 60px; height: 60px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-3 bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center text-muted" style="width: 60px; height: 60px;">
                                                <i class="bi bi-image fs-4"></i>
                                            </div>
                                        }
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">@ev.Title</h6>
                                            <small class="text-muted">Event ID: #@ev.EventId</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-primary small mb-1">@ev.EventType</span>
                                    <div class="small fw-semibold text-dark">@ev.StartDate.ToString("dd MMM yyyy")</div>
                                </td>
                                <td>
                                    <div class="small fw-semibold text-dark">@ev.City</div>
                                    <small class="text-muted">@ev.Province</small>
                                </td>
                                <td>
                                    <div class="small fw-bold text-dark">R @ev.EntryFeeZar.ToString("N0")</div>
                                    <small class="text-primary fw-semibold">@ev.TotalEnrolments / @ev.MaxEntries Entries</small>
                                </td>
                                <td>
                                    @if (ev.Status == "Open")
                                    {
                                        <span class="badge-status-confirmed small"><i class="bi bi-check-circle-fill"></i> Open</span>
                                    }
                                    else if (ev.Status == "Completed")
                                    {
                                        <span class="badge-status-completed small"><i class="bi bi-trophy-fill"></i> Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status-pending small">@ev.Status</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Enrolments" asp-route-eventId="@ev.EventId" class="btn btn-outline-primary btn-sm" title="View Enrolments">
                                            <i class="bi bi-people-fill me-1"></i> Roster (@ev.TotalEnrolments)
                                        </a>
                                        <a asp-action="Categories" asp-route-eventId="@ev.EventId" class="btn btn-outline-secondary btn-sm" title="Distance Categories">
                                            <i class="bi bi-tags"></i>
                                        </a>
                                        <a asp-action="Results" asp-route-eventId="@ev.EventId" class="btn btn-outline-warning text-dark btn-sm" title="Capture Timing Results">
                                            <i class="bi bi-trophy"></i>
                                        </a>
                                        <a asp-action="EditEvent" asp-route-id="@ev.EventId" class="btn btn-outline-dark btn-sm" title="Edit Event Details">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal-@ev.EventId" title="Delete Event">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Delete Confirmation Modal -->
                                    <div class="modal fade text-start" id="deleteModal-@ev.EventId" tabindex="-1" aria-labelledby="deleteModalLabel-@ev.EventId" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header bg-danger text-white">
                                                    <h5 class="modal-title" id="deleteModalLabel-@ev.EventId"><i class="bi bi-exclamation-triangle me-2"></i>Delete Event Confirmation</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p>Are you sure you want to permanently delete event <strong>@ev.Title</strong>?</p>
                                                    <div class="alert alert-warning small">
                                                        <i class="bi bi-info-circle me-1"></i> Note: Events with existing paid enrolments cannot be deleted to protect athlete records.
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="DeleteEvent" asp-route-id="@ev.EventId" method="post" class="d-inline">
                                                        <button type="submit" class="btn btn-danger">Yes, Delete Event</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

