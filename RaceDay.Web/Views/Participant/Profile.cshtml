@model EditProfileViewModel
@{
    ViewData["Title"] = "Athlete Profile & Settings";
    var profile = ViewBag.Profile as ProfileViewModel;
    var changePassword = ViewBag.ChangePassword as ChangePasswordViewModel ?? new ChangePasswordViewModel();
}

<div class="bg-dark text-white py-4 border-bottom border-secondary mb-4">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <span class="role-badge-participant mb-2 d-inline-block">Account Settings</span>
                <h1 class="h3 fw-bold mb-1">Athlete Profile</h1>
                <p class="text-white-50 small mb-0">Update contact details, club affiliation, and upload profile picture to Azure Blob Storage</p>
            </div>
            <div class="mt-3 mt-md-0 d-flex gap-2">
                <a asp-action="MyEvents" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-ticket-perforated me-1"></i> My Enrolments
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-4">
        <!-- Left Column: Profile Card & Azure Blob Picture Upload (Requirement 4 & 5) -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white mb-4">
                <div class="position-relative d-inline-block mx-auto mb-3">
                    @if (!string.IsNullOrEmpty(profile?.ProfilePictureUrl))
                    {
                        <img src="@profile.ProfilePictureUrl" alt="@profile.FullName" class="user-avatar-lg" />
                    }
                    else
                    {
                        <div class="user-avatar-lg bg-primary d-flex align-items-center justify-content-center text-white fs-1 fw-bold mx-auto">
                            @(string.IsNullOrEmpty(profile?.FullName) ? "U" : profile.FullName.Substring(0, 1).ToUpper())
                        </div>
                    }
                    <span class="badge bg-primary position-absolute bottom-0 end-0 rounded-circle p-2 shadow">
                        <i class="bi bi-camera-fill"></i>
                    </span>
                </div>

                <h4 class="fw-bold text-dark mb-1">@profile?.FullName</h4>
                <p class="text-muted small mb-3">@profile?.Email</p>

                <div class="d-flex justify-content-center gap-2 mb-3">
                    <span class="role-badge-participant">@profile?.Role</span>
                    @if (!string.IsNullOrEmpty(profile?.ClubName))
                    {
                        <span class="badge bg-light text-dark border">@profile.ClubName</span>
                    }
                </div>

                <div class="p-3 bg-light rounded-3 text-start small border">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Member Since:</span>
                        <strong class="text-dark">@profile?.CreatedAt.ToString("MMM yyyy")</strong>
                    </div>
                    @if (profile?.DateOfBirth.HasValue == true)
                    {
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Date of Birth:</span>
                            <strong class="text-dark">@profile.DateOfBirth.Value.ToString("dd MMM yyyy")</strong>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(profile?.Gender))
                    {
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Gender:</span>
                            <strong class="text-dark">@profile.Gender</strong>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(profile?.SAIDOrPassport))
                    {
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">ID / Passport:</span>
                            <strong class="text-dark">@profile.SAIDOrPassport</strong>
                        </div>
                    }
                </div>

                <!-- Azure Blob Storage Notice -->
                <div class="mt-3 p-2 bg-info bg-opacity-10 border border-info rounded-3 text-start small">
                    <i class="bi bi-cloud-check-fill text-info me-1"></i>
                    <strong>Azure Blob Storage:</strong> Profile pictures are stored securely in cloud container <code>raceday-profiles</code> via the Part 2 REST API.
                </div>
            </div>

            <!-- Change Password Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    <i class="bi bi-shield-lock text-primary me-2"></i>Security & Password
                </h6>
                <form asp-action="ChangePassword" method="post" novalidate>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Current Password</label>
                        <input type="password" name="CurrentPassword" class="form-control form-control-sm" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">New Password (Min 6 Chars)</label>
                        <input type="password" name="NewPassword" class="form-control form-control-sm" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Confirm New Password</label>
                        <input type="password" name="ConfirmPassword" class="form-control form-control-sm" required />
                    </div>
                    <button type="submit" class="btn btn-outline-dark btn-sm w-100">
                        Update Password
                    </button>
                </form>
            </div>
        </div>

        <!-- Right Column: Edit Profile Form & Avatar Upload -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-4">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Edit Personal Information
                </h5>

                <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data" novalidate>
                    <input type="hidden" asp-for="ExistingProfilePictureUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

                    <!-- 1. Profile Picture Upload (Azure Blob Storage) -->
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <label asp-for="ProfilePictureFile" class="form-label small fw-bold text-dark text-uppercase d-block">
                            <i class="bi bi-cloud-arrow-up text-primary me-1"></i>Upload New Profile Picture (Azure Blob Storage)
                        </label>
                        <input asp-for="ProfilePictureFile" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="ProfilePictureFile" class="text-danger small"></span>
                        <small class="text-muted d-block mt-1">Accepted formats: JPG, PNG, WebP (Max 5MB). File streams directly through Part 2 API to Azure Blob Storage.</small>
                    </div>

                    <!-- 2. Contact Details -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label small fw-bold text-muted text-uppercase">Full Name *</label>
                            <input asp-for="FullName" class="form-control" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label small fw-bold text-muted text-uppercase">Contact Phone</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="+27 82 123 4567" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Province" class="form-label small fw-bold text-muted text-uppercase">Province</label>
                            <select asp-for="Province" class="form-select">
                                <option value="Gauteng">Gauteng</option>
                                <option value="Western Cape">Western Cape</option>
                                <option value="KwaZulu-Natal">KwaZulu-Natal</option>
                                <option value="Eastern Cape">Eastern Cape</option>
                                <option value="Free State">Free State</option>
                                <option value="Mpumalanga">Mpumalanga</option>
                                <option value="Limpopo">Limpopo</option>
                                <option value="North West">North West</option>
                                <option value="Northern Cape">Northern Cape</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ClubName" class="form-label small fw-bold text-muted text-uppercase">Running / Athletic Club</label>
                            <input asp-for="ClubName" class="form-control" placeholder="Club name" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EmergencyContactName" class="form-label small fw-bold text-muted text-uppercase">Emergency Contact Name</label>
                            <input asp-for="EmergencyContactName" class="form-control" placeholder="Contact person" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EmergencyContactNo" class="form-label small fw-bold text-muted text-uppercase">Emergency Contact Phone</label>
                            <input asp-for="EmergencyContactNo" class="form-control" placeholder="+27 82 ..." />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TshirtSize" class="form-label small fw-bold text-muted text-uppercase">Preferred T-Shirt Size</label>
                            <select asp-for="TshirtSize" class="form-select">
                                <option value="XS">XS</option>
                                <option value="S">S</option>
                                <option value="M">M</option>
                                <option value="L">L</option>
                                <option value="XL">XL</option>
                                <option value="XXL">XXL</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 pt-3 border-top">
                        <button type="submit" class="btn btn-raceday-primary px-5 py-2 fs-6">
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

