@model MyResultsViewModel
@{
    ViewData["Title"] = "My Results";
}

<div class="bg-dark text-white py-4 border-bottom border-secondary mb-4">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <span class="role-badge-participant mb-2 d-inline-block">Official Timing History</span>
                <h1 class="h3 fw-bold mb-1"><i class="bi bi-trophy-fill text-warning me-2"></i>My Race Results</h1>
                <p class="text-white-50 small mb-0">Personal race history, official finish times, and finishing positions captured by race directors</p>
            </div>
            <div class="mt-3 mt-md-0 d-flex gap-2">
                <a asp-action="MyEvents" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-ticket-perforated me-1"></i> My Enrolments
                </a>
                <a asp-controller="Events" asp-action="Index" class="btn btn-raceday-accent btn-sm">
                    <i class="bi bi-compass me-1"></i> Enter New Event
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    <!-- Results Summary Metrics -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="stat-card stat-blue">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-val">@Model.TotalRacesCompleted</div>
                        <div class="stat-lbl">Completed Races</div>
                    </div>
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-flag-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card stat-orange">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-val">@Model.TotalKilometersRaced.ToString("N1") <span class="fs-5 text-muted">km</span></div>
                        <div class="stat-lbl">Total Distance Covered</div>
                    </div>
                    <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-activity"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card stat-green">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-val fs-3">@(string.IsNullOrEmpty(Model.BestFinishPosition) ? "Top Finisher" : Model.BestFinishPosition)</div>
                        <div class="stat-lbl">Best Finishing Position</div>
                    </div>
                    <div class="stat-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-award-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Official Results Table (Requirement 4: Event name, date, category, recorded finish time, and finishing position e.g. 47th out of 312 finishers) -->
    <div class="table-card">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark mb-0">Official Finisher Records</h5>
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">
                <i class="bi bi-check-circle-fill me-1"></i> Verified by Organisers
            </span>
        </div>

        @if (!Model.Results.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-trophy fs-1 d-block mb-2 text-muted"></i>
                <h5>No Results Recorded Yet</h5>
                <p class="small text-muted mb-3">
                    Your finish times and positions will appear here after the event organiser captures and publishes timing results on race day.
                </p>
                <a asp-action="MyEvents" class="btn btn-outline-primary rounded-pill px-4">Check My Registered Events</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-raceday mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Bib & Event Name</th>
                            <th>Race Date</th>
                            <th>Category</th>
                            <th>Finish Time</th>
                            <th>Finishing Position</th>
                            <th>Pace</th>
                            <th class="text-end">Certificate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Results)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="race-bib py-1 px-2" style="border-width: 2px;">
                                            <div class="race-bib-header" style="font-size: 0.5rem;">BIB</div>
                                            <div class="race-bib-number" style="font-size: 1.1rem;">#@r.BibNumber</div>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark fs-6">@r.EventTitle</div>
                                            <small class="text-muted"><i class="bi bi-geo-alt me-1 text-danger"></i>@r.City, @r.Province</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark"><i class="bi bi-calendar3 me-1 text-primary"></i>@r.EventDate.ToString("dd MMM yyyy")</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@r.CategoryName</div>
                                    <span class="badge bg-primary">@r.DistanceKm km</span>
                                </td>
                                <td>
                                    <div class="fw-bold fs-5 text-primary font-monospace">@r.FormattedFinishTime</div>
                                    @if (!string.IsNullOrEmpty(r.FormattedChipTime))
                                    {
                                        <small class="text-muted d-block" style="font-size: 0.72rem;">Chip: @r.FormattedChipTime</small>
                                    }
                                </td>
                                <td>
                                    <!-- Finishing Position Display (Requirement 4: e.g. 47th out of 312 finishers) -->
                                    <div class="fw-bold text-dark fs-6">
                                        <i class="bi bi-award-fill text-warning me-1"></i>@r.DisplayPosition
                                    </div>
                                    @if (!string.IsNullOrEmpty(r.DisplayCategoryPosition))
                                    {
                                        <span class="badge bg-light text-dark border small mt-1">@r.DisplayCategoryPosition</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace">@r.PacePerKm</span>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-outline-warning text-dark btn-sm rounded-pill px-3 shadow-sm"
                                            data-bs-toggle="modal" data-bs-target="#certModal-@r.ResultId">
                                        <i class="bi bi-patch-check-fill text-warning me-1"></i> Certificate
                                    </button>

                                    <!-- Finisher Certificate Modal -->
                                    <div class="modal fade text-start" id="certModal-@r.ResultId" tabindex="-1" aria-labelledby="certModalLabel-@r.ResultId" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered modal-lg">
                                            <div class="modal-content border-0 shadow-lg">
                                                <div class="modal-body p-5 text-center" style="background: radial-gradient(circle, #ffffff 60%, #f1f5f9 100%); border: 8px solid #0f172a; border-radius: 8px;">
                                                    <div class="brand-icon mx-auto mb-3" style="width: 50px; height: 50px;">
                                                        <i class="bi bi-trophy-fill fs-3 text-warning"></i>
                                                    </div>
                                                    <span class="text-uppercase fw-bold text-muted letter-spacing-1 small d-block mb-1">Official Finisher Certificate</span>
                                                    <h2 class="display-6 fw-bold text-dark mb-1">@r.EventTitle</h2>
                                                    <div class="text-muted mb-4">@r.EventDate.ToString("dd MMMM yyyy") &bull; @r.City, @r.Province</div>

                                                    <div class="my-4 py-3 border-top border-bottom">
                                                        <div class="small text-muted text-uppercase fw-bold mb-1">Assigned Race Bib</div>
                                                        <div class="display-5 fw-bold text-dark font-monospace mb-2">#@r.BibNumber</div>
                                                        <div class="fs-4 text-primary fw-bold">@r.CategoryName (@r.DistanceKm km)</div>
                                                    </div>

                                                    <div class="row g-3 justify-content-center my-4">
                                                        <div class="col-md-5">
                                                            <div class="p-3 bg-white rounded-3 shadow-sm border">
                                                                <small class="text-muted text-uppercase fw-bold d-block">Official Finish Time</small>
                                                                <span class="fs-3 fw-bold text-dark font-monospace">@r.FormattedFinishTime</span>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-5">
                                                            <div class="p-3 bg-white rounded-3 shadow-sm border">
                                                                <small class="text-muted text-uppercase fw-bold d-block">Overall Standing</small>
                                                                <span class="fs-3 fw-bold text-success">@r.DisplayPosition</span>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="text-muted small mt-4">
                                                        Authenticated by RaceDay Road Events Scoring System &bull; Official PROG6212 Timing Record
                                                    </div>
                                                </div>
                                                <div class="modal-footer bg-light">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                                                    <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">
                                                        <i class="bi bi-printer me-1"></i> Print Certificate
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

