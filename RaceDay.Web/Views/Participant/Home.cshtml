@{
    ViewData["Title"] = "Athlete Dashboard";
    var nextEvent = ViewBag.NextEvent as EnrolmentCardViewModel;
    var recentEnrolments = ViewBag.RecentEnrolments as List<EnrolmentCardViewModel> ?? new List<EnrolmentCardViewModel>();
    var recentResults = ViewBag.RecentResults as List<PersonalRaceResultItemViewModel> ?? new List<PersonalRaceResultItemViewModel>();
    var upcomingEvents = ViewBag.UpcomingEvents as List<EventCardViewModel> ?? new List<EventCardViewModel>();
}

<div class="bg-dark text-white py-4 border-bottom border-secondary mb-4">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <span class="role-badge-participant mb-2 d-inline-block">Athlete Portal</span>
                <h1 class="h3 fw-bold mb-1">Welcome back, Runner!</h1>
                <p class="text-white-50 small mb-0">Track your registrations, prepare for race morning, and review official finishing times</p>
            </div>
            <div class="mt-3 mt-md-0 d-flex gap-2">
                <a asp-controller="Events" asp-action="Index" class="btn btn-raceday-accent btn-sm">
                    <i class="bi bi-compass me-1"></i> Enter New Event
                </a>
                <a asp-action="MyResults" class="btn btn-outline-warning text-dark btn-sm">
                    <i class="bi bi-trophy-fill text-warning me-1"></i> My Results
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    <!-- Athlete Summary Metric Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="stat-card stat-blue">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-val">@ViewBag.TotalEnrolled</div>
                        <div class="stat-lbl">Events Enrolled</div>
                    </div>
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-ticket-perforated-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card stat-green">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-val">@ViewBag.TotalCompleted</div>
                        <div class="stat-lbl">Official Finishes</div>
                    </div>
                    <div class="stat-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-award-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card stat-gold">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-val">@ViewBag.TotalKm.ToString("N1") <span class="fs-5 text-muted">km</span></div>
                        <div class="stat-lbl">Total Race Distance</div>
                    </div>
                    <div class="stat-icon bg-warning bg-opacity-10 text-dark">
                        <i class="bi bi-geo-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Next Event Spotlight Widget -->
    @if (nextEvent != null)
    {
        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 mb-5 text-white position-relative overflow-hidden"
             style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%); border-left: 6px solid var(--rd-accent) !important;">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <span class="badge bg-warning text-dark text-uppercase fw-bold px-3 py-2 rounded-pill mb-2">
                        <i class="bi bi-clock-history me-1"></i> Next Race On Your Calendar
                    </span>
                    <h2 class="display-6 fw-bold mb-2 text-white">@nextEvent.EventTitle</h2>
                    <div class="d-flex flex-wrap gap-3 text-white-50 fs-6 mb-3">
                        <span><i class="bi bi-calendar3 me-1 text-primary"></i>@nextEvent.EventDate.ToString("dddd, dd MMMM yyyy")</span>
                        <span><i class="bi bi-geo-alt me-1 text-danger"></i>@nextEvent.City, @nextEvent.Province</span>
                        <span><i class="bi bi-tag-fill me-1 text-warning"></i>@nextEvent.CategoryName (@nextEvent.DistanceKm km)</span>
                    </div>
                    <div>
                        <span class="badge-status-confirmed"><i class="bi bi-check-circle-fill"></i> Status: @nextEvent.Status</span>
                    </div>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <div class="race-bib p-3">
                        <div class="race-bib-header">OFFICIAL RACEDAY BIB</div>
                        <div class="race-bib-number">#@nextEvent.BibNumber</div>
                        <div class="race-bib-footer">@nextEvent.CategoryName</div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Two-Column Section: Recent Enrolments & Recent Results -->
    <div class="row g-4 mb-5">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-ticket-perforated text-primary me-2"></i>My Enrolments</h5>
                    <a asp-action="MyEvents" class="small fw-bold text-primary text-decoration-none">View All &rarr;</a>
                </div>

                @if (!recentEnrolments.Any())
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-ticket-detailed fs-1 d-block mb-2"></i>
                        <p class="small mb-2">You haven't enrolled for any races yet.</p>
                        <a asp-controller="Events" asp-action="Index" class="btn btn-raceday-primary btn-sm rounded-pill px-3">Browse Events</a>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var en in recentEnrolments)
                        {
                            <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold text-dark">@en.EventTitle</div>
                                    <small class="text-muted">
                                        <i class="bi bi-calendar3 me-1"></i>@en.EventDate.ToString("dd MMM yyyy") &bull; @en.CategoryName
                                    </small>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-dark fw-bold mb-1 d-block">Bib #@en.BibNumber</span>
                                    @if (en.Status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success small"><i class="bi bi-check"></i> Confirmed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark small">@en.Status</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-trophy-fill text-warning me-2"></i>Recent Official Results</h5>
                    <a asp-action="MyResults" class="small fw-bold text-primary text-decoration-none">View All &rarr;</a>
                </div>

                @if (!recentResults.Any())
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-award fs-1 d-block mb-2"></i>
                        <p class="small mb-0">Official finishing times will appear here once you cross the timing mats!</p>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var res in recentResults)
                        {
                            <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold text-dark">@res.EventTitle</div>
                                    <small class="text-muted">
                                        @res.CategoryName &bull; @res.PacePerKm
                                    </small>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold fs-6 text-primary">@res.FormattedFinishTime</div>
                                    <span class="badge bg-warning text-dark small">@res.DisplayPosition</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

