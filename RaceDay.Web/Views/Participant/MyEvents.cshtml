@model List<EnrolmentCardViewModel>
@{
    ViewData["Title"] = "My Enrolments";
}

<div class="bg-dark text-white py-4 border-bottom border-secondary mb-4">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <span class="role-badge-participant mb-2 d-inline-block">My Race Schedule</span>
                <h1 class="h3 fw-bold mb-1">My Enrolled Events</h1>
                <p class="text-white-50 small mb-0">Personal view of all registered races, assigned bib numbers, and enrolment statuses</p>
            </div>
            <div class="mt-3 mt-md-0 d-flex gap-2">
                <a asp-controller="Events" asp-action="Index" class="btn btn-raceday-accent btn-sm">
                    <i class="bi bi-compass me-1"></i> Enter Another Event
                </a>
                <a asp-action="MyResults" class="btn btn-outline-warning text-dark btn-sm">
                    <i class="bi bi-trophy-fill text-warning me-1"></i> My Race Results
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4 bg-white">
            <div class="mb-3 text-muted"><i class="bi bi-ticket-detailed fs-1"></i></div>
            <h4>You Have No Active Enrolments</h4>
            <p class="text-muted">You haven't entered any road events yet. Explore upcoming races across South Africa and claim your race bib!</p>
            <div class="mt-2">
                <a asp-controller="Events" asp-action="Index" class="btn btn-raceday-primary rounded-pill px-4">
                    <i class="bi bi-calendar-event me-1"></i> Explore Upcoming Races
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var en in Model)
            {
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-white">
                        <div class="row g-0 h-100">
                            <!-- Left: Event banner snippet & Bib -->
                            <div class="col-sm-5 d-flex flex-column justify-content-between p-4 text-white position-relative"
                                 style="background: linear-gradient(135deg, rgba(15,23,42,0.85) 0%, rgba(30,58,138,0.95) 100%), url('@(string.IsNullOrEmpty(en.BannerUrl) ? "https://images.unsplash.com/photo-1530549387789-4c1017266635?auto=format&fit=crop&w=600&q=80" : en.BannerUrl)') center/cover no-repeat;">
                                <div>
                                    <span class="badge bg-warning text-dark small fw-bold text-uppercase mb-2">@en.EventType</span>
                                    <h5 class="fw-bold mb-1 text-white">@en.EventTitle</h5>
                                    <div class="small text-white-50">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>@en.City, @en.Province
                                    </div>
                                </div>

                                <div class="mt-3 text-center">
                                    <div class="race-bib py-2 px-3">
                                        <div class="race-bib-header">ASSIGNED BIB</div>
                                        <div class="race-bib-number">#@en.BibNumber</div>
                                        <div class="race-bib-footer">@en.CategoryName</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Category, Dates, and Status -->
                            <div class="col-sm-7 p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <span class="text-uppercase small text-muted fw-bold d-block" style="font-size: 0.72rem;">SELECTED CATEGORY</span>
                                            <strong class="text-dark fs-6">@en.CategoryName</strong>
                                        </div>
                                        <span class="badge bg-primary">@en.DistanceKm km</span>
                                    </div>

                                    <div class="small text-muted mb-2">
                                        <i class="bi bi-calendar3 me-1 text-primary"></i><strong>Race Date:</strong> @en.EventDate.ToString("dd MMM yyyy")
                                    </div>
                                    <div class="small text-muted mb-3">
                                        <i class="bi bi-clock-history me-1 text-secondary"></i><strong>Enrolled:</strong> @en.EnrolmentDate.ToString("dd MMM yyyy")
                                    </div>

                                    <!-- Visual Status Badge (Requirement 4 & 7: Visually distinct colour coding) -->
                                    <div class="mb-3">
                                        <span class="text-uppercase small text-muted fw-bold d-block mb-1" style="font-size: 0.72rem;">ENROLMENT STATUS</span>
                                        @if (en.Status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge-status-confirmed"><i class="bi bi-check-circle-fill"></i> Confirmed</span>
                                        }
                                        else if (en.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge-status-pending"><i class="bi bi-hourglass-split"></i> Pending</span>
                                        }
                                        else
                                        {
                                            <span class="badge-status-cancelled"><i class="bi bi-x-circle-fill"></i> Cancelled</span>
                                        }
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                                    <small class="text-muted">Fee Paid: <strong>R @en.FeePaidZar.ToString("N0")</strong></small>
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Events" asp-action="Details" asp-route-id="@en.EventId" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                            Event Info
                                        </a>
                                        @if (en.HasResult)
                                        {
                                            <a asp-action="MyResults" class="btn btn-outline-warning text-dark btn-sm rounded-pill px-3">
                                                <i class="bi bi-trophy-fill text-warning"></i> Results
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

