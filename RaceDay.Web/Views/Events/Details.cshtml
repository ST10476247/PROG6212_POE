@model EventDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<!-- Event Banner Header with Azure Blob Image -->
<div class="position-relative text-white" style="background: linear-gradient(180deg, rgba(15,23,42,0.8) 0%, rgba(15,23,42,0.95) 100%), url('@(string.IsNullOrEmpty(Model.BannerUrl) ? "https://images.unsplash.com/photo-1530549387789-4c1017266635?auto=format&fit=crop&w=1600&q=80" : Model.BannerUrl)') center/cover no-repeat; min-height: 340px; display: flex; align-items: flex-end; padding: 3rem 0; border-bottom: 4px solid var(--rd-accent);">
    <div class="container">
        <div class="row align-items-end g-4">
            <div class="col-lg-8">
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <span class="badge bg-warning text-dark text-uppercase fw-bold px-3 py-2 rounded-pill">
                        <i class="bi @(Model.EventType == "Running" ? "bi-person-walking" : Model.EventType == "Cycling" ? "bi-bicycle" : "bi-tree") me-1"></i>
                        @Model.EventType
                    </span>
                    @if (Model.Status == "Open")
                    {
                        <span class="badge-status-confirmed"><i class="bi bi-check-circle-fill"></i> Entries Open</span>
                    }
                    else if (Model.Status == "Completed")
                    {
                        <span class="badge-status-completed"><i class="bi bi-trophy-fill"></i> Official Results Published</span>
                    }
                    else
                    {
                        <span class="badge-status-pending">@Model.Status</span>
                    }
                    <span class="badge bg-dark bg-opacity-75 text-white border border-light border-opacity-25 px-3 py-2 rounded-pill">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.City, @Model.Province
                    </span>
                </div>

                <h1 class="display-5 fw-bold text-white mb-2">@Model.Title</h1>
                <p class="text-white-50 fs-5 mb-0">
                    <i class="bi bi-calendar-event me-2"></i>@Model.StartDate.ToString("dddd, dd MMMM yyyy")
                </p>
            </div>

            <div class="col-lg-4 text-lg-end">
                @if (Model.IsUserEnrolled)
                {
                    <div class="bg-success bg-opacity-25 border border-success p-3 rounded-4 text-start">
                        <div class="d-flex align-items-center gap-2 text-success fw-bold mb-1">
                            <i class="bi bi-check-circle-fill fs-5"></i> You Are Enrolled!
                        </div>
                        <small class="text-white-50">Status: <span class="badge bg-success">@Model.UserEnrolmentStatus</span></small>
                        <div class="mt-2">
                            <a asp-controller="Participant" asp-action="MyEvents" class="btn btn-sm btn-outline-light rounded-pill">
                                View Ticket & Bib
                            </a>
                        </div>
                    </div>
                }
                else if (Model.Status == "Open")
                {
                    <a asp-controller="Participant" asp-action="Enrol" asp-route-eventId="@Model.EventId" class="btn btn-raceday-accent btn-lg px-4 py-3 rounded-pill shadow-lg">
                        <i class="bi bi-ticket-perforated-fill me-2"></i> Enter This Event Now
                    </a>
                }
                else if (Model.Status == "Completed")
                {
                    <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-outline-light btn-lg px-4 rounded-pill">
                        <i class="bi bi-trophy me-2"></i> View Leaderboards
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="container my-5">
    <div class="row g-4">
        <!-- Main Event Details -->
        <div class="col-lg-8">
            <!-- Event Description Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                <h4 class="fw-bold text-dark mb-3"><i class="bi bi-info-circle text-primary me-2"></i>About This Event</h4>
                <p class="text-secondary leading-relaxed mb-0" style="white-space: pre-line;">
                    @(string.IsNullOrEmpty(Model.Description) ? "Join athletes from across South Africa for this road event." : Model.Description)
                </p>
            </div>

            <!-- Available Race Categories Table (Requirement 3 & 4) -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold text-dark mb-0"><i class="bi bi-tags text-primary me-2"></i>Available Race Categories</h4>
                    <span class="badge bg-primary rounded-pill px-3">@Model.Categories.Count Categories</span>
                </div>

                @if (!Model.Categories.Any())
                {
                    <div class="alert alert-info small mb-0">
                        <i class="bi bi-info-circle me-1"></i> Distance categories are being configured by the race organiser. Please check back shortly.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Category & Distance</th>
                                    <th>Start Time</th>
                                    <th>Age Limit</th>
                                    <th>Entry Fee</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cat in Model.Categories)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark">@cat.CategoryName</div>
                                            <span class="badge bg-secondary">@cat.DistanceKm km</span>
                                        </td>
                                        <td>
                                            <i class="bi bi-clock me-1 text-muted"></i>@cat.FormattedStartTime
                                        </td>
                                        <td>@cat.AgeBracket</td>
                                        <td>
                                            <span class="fw-bold text-primary">
                                                R @(cat.EntryFeeZar?.ToString("N0") ?? Model.EntryFeeZar.ToString("N0"))
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            @if (Model.Status == "Open" && !Model.IsUserEnrolled)
                                            {
                                                <a asp-controller="Participant" asp-action="Enrol" asp-route-eventId="@Model.EventId" asp-route-categoryId="@cat.CategoryId" class="btn btn-raceday-accent btn-sm rounded-pill px-3">
                                                    Enter Category
                                                </a>
                                            }
                                            else if (Model.IsUserEnrolled)
                                            {
                                                <span class="badge bg-success"><i class="bi bi-check"></i> Registered</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Route & Elevation Profile -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h4 class="fw-bold text-dark mb-3"><i class="bi bi-map text-primary me-2"></i>Route Profile & Elevation</h4>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <small class="text-muted text-uppercase fw-bold d-block">Elevation Gain</small>
                            <span class="fs-4 fw-bold text-dark">@Model.ElevationGainMeters m</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <small class="text-muted text-uppercase fw-bold d-block">Terrain Surface</small>
                            <span class="fs-5 fw-bold text-dark">@(Model.TerrainType ?? "Road / Tarmac")</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <small class="text-muted text-uppercase fw-bold d-block">Max Field Size</small>
                            <span class="fs-4 fw-bold text-dark">@Model.MaxEntries Entrants</span>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.KeyLandmarks))
                {
                    <div class="mt-3 p-3 bg-light rounded-3">
                        <strong class="text-dark small d-block mb-1"><i class="bi bi-pin-map-fill text-danger me-1"></i>Key Course Landmarks:</strong>
                        <span class="text-secondary small">@Model.KeyLandmarks</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.RouteUrl))
                {
                    <div class="mt-3">
                        <a href="@Model.RouteUrl" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill">
                            <i class="bi bi-box-arrow-up-right me-1"></i> View Interactive Course Map (GPS)
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar Information -->
        <div class="col-lg-4">
            <!-- Event Quick Stats Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                <h5 class="fw-bold text-dark mb-3">Event Summary</h5>
                <ul class="list-unstyled mb-0">
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Host Club / Organiser:</span>
                        <strong class="text-dark">@(string.IsNullOrEmpty(Model.OrganiserName) ? "Host Club" : Model.OrganiserName)</strong>
                    </li>
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Event Date:</span>
                        <strong class="text-dark">@Model.StartDate.ToString("dd MMM yyyy")</strong>
                    </li>
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Location:</span>
                        <strong class="text-dark">@Model.City, @Model.Province</strong>
                    </li>
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Current Field:</span>
                        <strong class="text-primary">@Model.EntrantsCount / @Model.MaxEntries Entries</strong>
                    </li>
                    <li class="d-flex justify-content-between py-2">
                        <span class="text-muted">Entry Fee Range:</span>
                        <strong class="text-dark">From R @Model.EntryFeeZar.ToString("N0")</strong>
                    </li>
                </ul>
            </div>

            <!-- Banner Poster Cloud Storage Info -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <div class="text-primary mb-2"><i class="bi bi-cloud-check-fill fs-2 text-info"></i></div>
                <h6 class="fw-bold mb-1">Azure Blob Storage Active</h6>
                <small class="text-muted">
                    This race poster is stored in Microsoft Azure Blob Storage container <code>raceday-banners</code> via the Part 2 RESTful Web API.
                </small>
            </div>
        </div>
    </div>
</div>

