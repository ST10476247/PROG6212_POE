@model LoginViewModel
@{
    ViewData["Title"] = "Log In";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-8">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <!-- Header Banner -->
                <div class="p-4 text-white text-center" style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);">
                    <div class="brand-icon mx-auto mb-2"><i class="bi bi-person-fill-lock"></i></div>
                    <h3 class="fw-bold mb-1">Welcome Back</h3>
                    <p class="text-white-50 small mb-0">Sign in to manage events or track your race entries</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Login" method="post" novalidate>
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold small text-uppercase text-muted">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" id="loginEmail" class="form-control border-start-0" placeholder="athlete@raceday.co.za" autofocus />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label asp-for="Password" class="form-label fw-semibold small text-uppercase text-muted mb-0">Password</label>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-key"></i></span>
                                <input asp-for="Password" id="loginPassword" type="password" class="form-control border-start-0" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small text-muted">Keep me signed in on this device</label>
                        </div>

                        <button type="submit" class="btn btn-raceday-primary w-100 py-2 fs-6">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to RaceDay
                        </button>
                    </form>

                    <!-- Quick Credentials Sandbox for Markers & Demonstrations -->
                    <div class="mt-4 pt-3 border-top">
                        <div class="small fw-bold text-uppercase text-muted mb-2 text-center">
                            <i class="bi bi-lightning-charge-fill text-warning"></i> Demo Test Accounts (Click to Fill)
                        </div>
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-outline-warning btn-sm text-dark d-flex align-items-center justify-content-between px-3"
                                    onclick="fillCredentials('john.smith@raceday.co.za', 'P@ssword123!')">
                                <span><i class="bi bi-briefcase-fill text-warning me-2"></i><strong>Organiser:</strong> John Smith</span>
                                <span class="badge bg-warning text-dark">Host Events</span>
                            </button>
                            <button type="button" class="btn btn-outline-success btn-sm text-dark d-flex align-items-center justify-content-between px-3"
                                    onclick="fillCredentials('sipho.dlamini@email.co.za', 'P@ssword123!')">
                                <span><i class="bi bi-person-walking text-success me-2"></i><strong>Participant:</strong> Sipho Dlamini</span>
                                <span class="badge bg-success text-white">Enter Races</span>
                            </button>
                        </div>
                    </div>

                    <div class="text-center mt-4 pt-2">
                        <span class="small text-muted">Don't have an account yet?</span>
                        <a asp-action="Register" class="small fw-bold text-primary text-decoration-none ms-1">Register Here</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

