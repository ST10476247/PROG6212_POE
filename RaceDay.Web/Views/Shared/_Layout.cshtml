@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var currentUser = HttpContextAccessor.HttpContext?.Session.GetCurrentUser();
    bool isLoggedIn = currentUser != null && currentUser.UserId > 0;
    bool isOrganiser = currentUser?.IsOrganiser ?? false;
    bool isParticipant = currentUser?.IsParticipant ?? false;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay Road Events</title>
    
    <!-- Google Fonts: Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- RaceDay Athletic Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Main RaceDay Navigation Header -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark raceday-navbar">
            <div class="container">
                <a class="navbar-brand navbar-brand-raceday" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon"><i class="bi bi-stopwatch-fill"></i></span>
                    <span>Race<span class="brand-text-accent">Day</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link nav-link-raceday" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-raceday" asp-controller="Events" asp-action="Index">
                                <i class="bi bi-calendar-event"></i> Explore Events
                            </a>
                        </li>

                        @if (isLoggedIn && isOrganiser)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-raceday" asp-controller="Organiser" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-raceday" asp-controller="Organiser" asp-action="Events">
                                    <i class="bi bi-kanban"></i> Manage Events
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-raceday" asp-controller="Organiser" asp-action="CreateEvent">
                                    <i class="bi bi-plus-circle-fill text-warning"></i> Host Event
                                </a>
                            </li>
                        }

                        @if (isLoggedIn && isParticipant)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-raceday" asp-controller="Participant" asp-action="Home">
                                    <i class="bi bi-activity"></i> My Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-raceday" asp-controller="Participant" asp-action="MyEvents">
                                    <i class="bi bi-ticket-perforated"></i> My Enrolments
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-raceday" asp-controller="Participant" asp-action="MyResults">
                                    <i class="bi bi-trophy-fill text-warning"></i> My Results
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- User Account / Authentication Corner -->
                    <ul class="navbar-nav align-items-center">
                        @if (isLoggedIn)
                        {
                            <li class="nav-item dropdown me-2">
                                <a class="nav-link dropdown-toggle nav-link-raceday d-flex align-items-center gap-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @if (!string.IsNullOrEmpty(currentUser?.ProfilePictureUrl))
                                    {
                                        <img src="@currentUser.ProfilePictureUrl" alt="@currentUser.FullName" class="user-avatar-sm" />
                                    }
                                    else
                                    {
                                        <div class="user-avatar-sm bg-primary d-flex align-items-center justify-content-center text-white fw-bold">
                                            @(string.IsNullOrEmpty(currentUser?.FullName) ? "U" : currentUser.FullName.Substring(0, 1).ToUpper())
                                        </div>
                                    }
                                    <div class="d-none d-md-block text-start">
                                        <div class="fw-semibold text-white lh-1">@currentUser?.FullName</div>
                                        <small class="text-white-50" style="font-size: 0.72rem;">@currentUser?.Email</small>
                                    </div>
                                    @if (isOrganiser)
                                    {
                                        <span class="role-badge-organiser ms-1">Organiser</span>
                                    }
                                    else if (isParticipant)
                                    {
                                        <span class="role-badge-participant ms-1">Athlete</span>
                                    }
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userDropdown">
                                    <li><h6 class="dropdown-header text-uppercase">@currentUser?.Role Account</h6></li>
                                    @if (isOrganiser)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Organiser" asp-action="Dashboard">
                                                <i class="bi bi-speedometer2 me-2"></i> Organiser Dashboard
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Organiser" asp-action="Events">
                                                <i class="bi bi-collection me-2"></i> My Hosted Events
                                            </a>
                                        </li>
                                    }
                                    else if (isParticipant)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Participant" asp-action="Profile">
                                                <i class="bi bi-person-badge me-2"></i> My Athlete Profile
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Participant" asp-action="MyEvents">
                                                <i class="bi bi-ticket-detailed me-2"></i> Registered Events
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Participant" asp-action="MyResults">
                                                <i class="bi bi-award me-2"></i> Personal Race History
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> End Session & Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3">
                                        <i class="bi bi-box-arrow-right"></i> Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="nav-link nav-link-raceday" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Log In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-raceday-accent btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus-fill"></i> Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Flash Notification Banners -->
    <div class="container mt-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                <div class="flex-grow-1">@TempData["Success"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
                <div class="flex-grow-1">@TempData["Error"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Warning"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-info-circle-fill fs-5 me-2 text-warning"></i>
                <div class="flex-grow-1">@TempData["Warning"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main View Body -->
    <main role="main" class="pb-5 flex-grow-1">
        @RenderBody()
    </main>

    <!-- Professional RaceDay Footer -->
    <footer class="raceday-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="brand-icon"><i class="bi bi-stopwatch-fill"></i></span>
                        <span class="h4 text-white mb-0 fw-bold">Race<span class="brand-text-accent">Day</span></span>
                    </div>
                    <p class="text-secondary small mb-3">
                        South Africa's premier road-event management platform powering iconic races including Comrades Marathon, Cape Town Cycle Tour, Soweto Marathon, and community park runs.
                    </p>
                    <div class="d-flex gap-2">
                        <span class="badge bg-dark border border-secondary text-secondary"><i class="bi bi-cloud-arrow-up text-info"></i> Azure Blob Storage</span>
                        <span class="badge bg-dark border border-secondary text-secondary"><i class="bi bi-box-seam text-primary"></i> Docker</span>
                        <span class="badge bg-dark border border-secondary text-secondary"><i class="bi bi-cpu text-success"></i> .NET 8 LTS</span>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white text-uppercase fw-bold mb-3 small">Navigation</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="mb-2"><a asp-controller="Events" asp-action="Index">Events Directory</a></li>
                        <li class="mb-2"><a asp-controller="Account" asp-action="Login">Login</a></li>
                        <li class="mb-2"><a asp-controller="Account" asp-action="Register">Register</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6 col-6">
                    <h6 class="text-white text-uppercase fw-bold mb-3 small">Student Project</h6>
                    <ul class="list-unstyled small text-secondary mb-0">
                        <li class="mb-2"><strong class="text-white">Module:</strong> PROG6212 PoE Part 3</li>
                        <li class="mb-2"><strong class="text-white">Student:</strong> Lesedi Mogatwe</li>
                        <li class="mb-2"><strong class="text-white">Student No:</strong> ST10476247</li>
                        <li class="mb-2"><strong class="text-white">Email:</strong> st10476247@rcconnect.edu.za</li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white text-uppercase fw-bold mb-3 small">Status Badges Legend</h6>
                    <div class="d-flex flex-column gap-2 small">
                        <div><span class="badge-status-confirmed me-2"><i class="bi bi-check-circle-fill"></i> Confirmed</span> <span class="text-secondary">Entry verified</span></div>
                        <div><span class="badge-status-pending me-2"><i class="bi bi-hourglass-split"></i> Pending</span> <span class="text-secondary">Awaiting check-in</span></div>
                        <div><span class="badge-status-completed me-2"><i class="bi bi-trophy-fill"></i> Completed</span> <span class="text-secondary">Results recorded</span></div>
                    </div>
                </div>
            </div>

            <div class="border-top border-secondary pt-3 d-flex flex-column flex-md-row justify-content-between align-items-center small text-secondary">
                <div>&copy; 2026 RaceDay Platform. All Rights Reserved. PROG6212 Portfolio of Evidence.</div>
                <div class="mt-2 mt-md-0">
                    <a asp-controller="Home" asp-action="Privacy" class="me-3">Privacy Policy</a>
                    <a href="https://github.com/ST10476247/PROG6212_POE" target="_blank"><i class="bi bi-github me-1"></i> GitHub Repository</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS with Popper -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
